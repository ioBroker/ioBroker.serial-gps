{
    "name": "iobroker.serial-gps",
    "version": "1.0.0",
    "description": "This adapter reads position from GPS mouse (serial or USB)",
    "author": {
        "name": "bluefox",
        "email": "dogafox@gmail.com"
    },
    "homepage": "https://github.com/ioBroker/ioBroker.serial-gps",
    "keywords": [
        "ioBroker",
        "gps"
    ],
    "engines": {
        "node": ">=22.19.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/ioBroker/ioBroker.serial-gps"
    },
    "dependencies": {
        "@iobroker/adapter-core": "^3.4.3",
        "serialport": "^13.0.0"
    },
    "devDependencies": {
        "@alcalzone/release-script": "^5.2.1",
        "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
        "@alcalzone/release-script-plugin-license": "^5.2.2",
        "@iobroker/build-tools": "^3.0.3",
        "@iobroker/eslint-config": "^2.3.4",
        "@iobroker/legacy-testing": "^4.0.0",
        "@iobroker/testing": "^6.3.0",
        "@iobroker/types": "^7.2.5",
        "@tsconfig/node22": "^22.0.6",
        "@types/node": "^22.20.5",
        "typescript": "~6.0.3"
    },
    "bugs": {
        "url": "https://github.com/ioBroker/ioBroker.serial-gps/issues"
    },
    "main": "build/main.js",
    "files": [
        "admin/",
        "doc/",
        "img/",
        "keys/",
        "build/",
        "io-package.json",
        "LICENSE"
    ],
    "scripts": {
        "prepublishOnly": "npm run build",
        "test:integration": "mocha test/adapter.test.js --exit",
        "test:package": "mocha test/package.test.js --exit",
        "test": "npm run test:integration",
        "lint": "eslint -c eslint.config.mjs",
        "build": "tsc -p tsconfig.build.json",
        "release": "release-script",
        "release-patch": "release-script patch --yes",
        "release-minor": "release-script minor --yes",
        "release-major": "release-script major --yes",
        "update-packages": "npx -y npm-check-updates"
    },
    "license": "MIT",
    "readmeFilename": "README.md"
}
